      "AudioEnhanceParam": {
        "type": "object",
        "properties": {
          "audio3dEnable": {
            "type": "boolean",
            "description": "Enable 2D to 3D audio conversion. Defaults to true on the audio task API; the audio path is skipped when disabled",
            "default": true
          },
          "layout": {
            "type": "string",
            "description": "Output speaker layout. Allowed values: 7.1.4, 7.1.0, 5.1.4, 5.1.0",
            "example": "5.1.4"
          },
          "sampleRate": {
            "type": "number",
            "description": "Sample rate (kHz)",
            "format": "double",
            "example": 44.1
          },
          "format": {
            "type": "string",
            "description": "Output audio file type. Allowed values: wav, av3a",
            "example": "wav"
          },
          "audioBitrate": {
            "type": "string",
            "description": "Audio bitrate (kbps)",
            "example": "832"
          },
          "useFakeStereo": {
            "type": "boolean",
            "description": "Use fake stereo processing. Defaults to false",
            "default": false
          },
          "enableVoiceOverflow": {
            "type": "boolean",
            "description": "Enable vocal overflow. Defaults to false",
            "default": false
          },
          "enableVolumeGain": {
            "type": "boolean",
            "description": "Enable volume gain. Defaults to false",
            "default": false
          },
          "volumeGainParam": {
            "$ref": "#/components/schemas/VolumeGainParam"
          }
        },
        "description": "Audio enhancement parameters"
      },
      "BaseParam": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "description": "输出格式",
            "example": "origin, mp4, mov, ts"
          },
          "codec": {
            "type": "string",
            "description": "视频编码",
            "example": "H.265, H.264"
          },
          "bitrateControl": {
            "type": "integer",
            "description": "码率控制：0-保持原样，1-VBR(可变码率)，2-CBR(恒定码率)，3-CRF(恒定质量)，4-自定义，5-推荐码率",
            "format": "int32"
          },
          "bitrate": {
            "type": "integer",
            "description": "目标视频码率 (Kb/s)",
            "format": "int32",
            "example": 30
          }
        },
        "description": "视频处理基础参数"
      },
      "MediaMetadata": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string"
          },
          "codec": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "frameRate": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "hdrFormat": {
            "type": "string"
          },
          "bitrate": {
            "type": "integer",
            "format": "int32"
          },
          "bitRateMode": {
            "type": "string"
          },
          "audioCodec": {
            "type": "string"
          },
          "audioSampleRate": {
            "type": "integer",
            "format": "int32"
          },
          "audioChannelLayout": {
            "type": "string"
          },
          "audioBitrate": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "colorTransfer": {
            "type": "string"
          },
          "colorPrimaries": {
            "type": "string"
          },
          "colorSpace": {
            "type": "string"
          }
        },
        "description": "Output video metadata"
      },
      "TaskDetailVo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Auto-increment database primary key",
            "format": "int64"
          },
          "taskId": {
            "type": "string",
            "description": "Globally unique task id"
          },
          "taskName": {
            "type": "string",
            "description": "Task name"
          },
          "inputUrl": {
            "type": "string",
            "description": "Source video download URL"
          },
          "status": {
            "type": "integer",
            "description": "Task status: 0 - wait schedule, 1 - downloading, 2 - wait resource, 3 - processing, 4 - uploading, 5 - success, 6 - cancelling, 7 - cancelled, -1 - failed",
            "format": "int32"
          },
          "param": {
            "$ref": "#/components/schemas/TranscodeParamVo"
          },
          "queue": {
            "type": "string",
            "description": "Task queue name (default is the default queue)"
          },
          "workerIp": {
            "type": "string",
            "description": "IP of the worker instance executing this task"
          },
          "inMetadata": {
            "$ref": "#/components/schemas/MediaMetadata"
          },
          "outPath": {
            "type": "string",
            "description": "Object storage key of the output file"
          },
          "outName": {
            "type": "string",
            "description": "Output file name (user specified outName or the default <source_file_name>_out.<ext>)"
          },
          "outUrl": {
            "type": "string",
            "description": "Output video download URL, available after the task succeeds; for private buckets it is a pre-signed URL valid for the configured period"
          },
          "outSize": {
            "type": "integer",
            "description": "Output file size in bytes",
            "format": "int64"
          },
          "outMetadata": {
            "$ref": "#/components/schemas/MediaMetadata"
          },
          "failCode": {
            "type": "integer",
            "description": "Failure code, 0 on success",
            "format": "int32"
          },
          "failLog": {
            "type": "string",
            "description": "Failure log, recorded on failure"
          },
          "videoProgress": {
            "type": "number",
            "description": "Video processing progress (0-1, null means no progress yet)"
          },
          "audioProgress": {
            "type": "number",
            "description": "Audio processing progress (0-1, null means no progress yet, e.g. audio path disabled)"
          },
          "downloadProgress": {
            "type": "number",
            "description": "Source video download progress (0-1, null means no progress yet)"
          },
          "uploadProgress": {
            "type": "number",
            "description": "Output video upload progress (0-1, null means no progress yet)"
          },
          "message": {
            "type": "string",
            "description": "Task processing message (success/failure description)"
          },
          "extra": {
            "type": "string",
            "description": "Extra field (reserved)"
          },
          "callerId": {
            "type": "string",
            "description": "Caller id"
          },
          "retryCount": {
            "type": "integer",
            "description": "Retry count",
            "format": "int32"
          },
          "startTime": {
            "type": "string",
            "description": "Task start time (yyyy-MM-dd HH:mm:ss, GMT+8)",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "description": "Task end time (success/failure/cancel time)",
            "format": "date-time"
          },
          "createTime": {
            "type": "string",
            "description": "Task creation time",
            "format": "date-time"
          },
          "updateTime": {
            "type": "string",
            "description": "Task last update time",
            "format": "date-time"
          }
        },
        "description": "Task detail (full version, including transcode params and input/output metadata)"
      },
      "TranscodeParam": {
        "type": "object",
        "properties": {
          "baseParam": {
            "$ref": "#/components/schemas/BaseParam"
          },
          "videoEnhanceParam": {
            "$ref": "#/components/schemas/VideoEnhanceParam"
          },
          "audioEnhanceParam": {
            "$ref": "#/components/schemas/AudioEnhanceParam"
          }
        },
        "description": "转码任务参数"
      },
      "VideoEnhanceParam": {
        "type": "object",
        "properties": {
          "sdrToHdrEnable": {
            "type": "boolean",
            "description": "SDR转HDR"
          },
          "hdrOpt": {
            "type": "integer",
            "description": "hdr选项，1：HDR 2: HDR2HDR Vivid",
            "format": "int32"
          },
          "hdrMode": {
            "type": "string",
            "description": "hdr格式，可选的有：PQ HLG"
          },
          "hdrLuminosity": {
            "type": "integer",
            "description": "hdr亮度，可选的有：1000、850、750、550、260、203",
            "format": "int32"
          },
          "hdrToHdrVividEnable": {
            "type": "boolean",
            "description": "HDR转HDR Vivid"
          },
          "superResolutionEnable": {
            "type": "boolean",
            "description": "是否开启超分辨率"
          },
          "outputResolutionOpt": {
            "type": "integer",
            "description": "输出分辨率选项",
            "format": "int32"
          },
          "resolution": {
            "type": "string",
            "description": "自定义分辨率（如\"1920x1080\"），outputResolutionOpt=8时有效"
          },
          "cropSetting": {
            "type": "integer",
            "description": "裁剪设置",
            "format": "int32"
          },
          "sceneModel": {
            "type": "integer",
            "description": "场景模型",
            "format": "int32"
          },
          "intelliFrameInsertEnable": {
            "type": "boolean",
            "description": "是否开启智能插帧"
          },
          "frameRate": {
            "type": "integer",
            "description": "帧率",
            "format": "int32"
          }
        },
        "description": "视频增强参数"
      },
      "VolumeGainParam": {
        "type": "object",
        "properties": {
          "l": {
            "type": "number",
            "description": "Left front channel gain (dB)"
          },
          "r": {
            "type": "number",
            "description": "Right front channel gain (dB)"
          },
          "c": {
            "type": "number",
            "description": "Center channel gain (dB)"
          },
          "lfe": {
            "type": "number",
            "description": "Low frequency effect channel gain (dB)"
          },
          "ls": {
            "type": "number",
            "description": "Left surround channel gain (dB)"
          },
          "rs": {
            "type": "number",
            "description": "Right surround channel gain (dB)"
          },
          "lrs": {
            "type": "number",
            "description": "Left rear surround channel gain (dB)"
          },
          "rrs": {
            "type": "number",
            "description": "Right rear surround channel gain (dB)"
          },
          "ltf": {
            "type": "number",
            "description": "Left top front channel gain (dB)"
          },
          "rtf": {
            "type": "number",
            "description": "Right top front channel gain (dB)"
          },
          "ltr": {
            "type": "number",
            "description": "Left top rear channel gain (dB)"
          },
          "rtr": {
            "type": "number",
            "description": "Right top rear channel gain (dB)"
          }
        },
        "description": "Volume gain parameters"
      },
      "TaskCreateParam": {
        "required": [
          "inputUrl"
        ],
        "type": "object",
        "properties": {
          "taskName": {
            "type": "string",
            "description": "任务名称，可选",
            "example": "xx任务"
          },
          "inputUrl": {
            "type": "string",
            "description": "源文件下载url",
            "example": "https://example.com/input.mp4"
          },
          "param": {
            "$ref": "#/components/schemas/TranscodeParam"
          },
          "outName": {
            "type": "string",
            "description": "输出文件名，不带路径斜杠，不带特殊字符",
            "example": "output.mp4"
          },
          "callerId": {
            "type": "string",
            "description": "调用者id，api系统分配，全局唯一，确定调用者的身份",
            "example": "callerId"
          },
          "apiKey": {
            "type": "string",
            "description": "api鉴权密钥",
            "example": "apiKey"
          }
        },
        "description": "创建api转码任务参数"
      },
      "ApiResultString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ApiResultListString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ApiResultTaskDetailVo": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TaskDetailVo"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "SuperResolutionParam": {
        "type": "object",
        "properties": {
          "superResolutionEnable": {
            "type": "boolean",
            "description": "Enable super resolution. Defaults to true on the super resolution task API",
            "default": true
          },
          "outputResolutionOpt": {
            "type": "integer",
            "description": "Output resolution option: 1 - original, 2 - 2x upscale, 3 - 4x upscale, 4 - 1280x720 (HD), 5 - 1920x1080 (FHD), 6 - 2560x1440 (QHD), 7 - 3840x2160 (4K), 8 - custom",
            "format": "int32",
            "example": 7
          },
          "resolution": {
            "type": "string",
            "description": "Custom resolution such as \"1920x1080\", required when outputResolutionOpt is 8",
            "example": "1920x1080"
          },
          "cropSetting": {
            "type": "integer",
            "description": "Crop setting: 1 - auto fit (keep aspect ratio), 2 - auto crop",
            "format": "int32",
            "example": 1
          },
          "sceneModel": {
            "type": "integer",
            "description": "Scene model: 1 - real-world scene, 2 - anime scene",
            "format": "int32",
            "example": 1
          }
        },
        "description": "Video super resolution parameters"
      },
      "SuperResolutionTaskCreateParam": {
        "required": [
          "inputUrl",
          "param"
        ],
        "type": "object",
        "properties": {
          "taskName": {
            "type": "string",
            "description": "Task name, optional",
            "example": "super-resolution-demo"
          },
          "inputUrl": {
            "type": "string",
            "description": "Source video download URL (http/https)",
            "example": "https://example.com/input.mp4"
          },
          "param": {
            "$ref": "#/components/schemas/SuperResolutionParam"
          },
          "outName": {
            "type": "string",
            "description": "Output file name, no path separators or special characters. Defaults to <source_file_name>_out.<ext> when omitted",
            "example": "output.mp4"
          },
          "callerId": {
            "type": "string",
            "description": "Caller id assigned by the API system, globally unique",
            "example": "callerId"
          },
          "apiKey": {
            "type": "string",
            "description": "API key for authentication, compared with api.api-key configured on the server",
            "example": "apiKey"
          }
        },
        "description": "Create video super resolution task request"
      },
      "SdrToHdrParam": {
        "type": "object",
        "properties": {
          "sdrToHdrEnable": {
            "type": "boolean",
            "description": "Enable SDR to HDR conversion. Defaults to true on the SDR-to-HDR task API",
            "default": true
          },
          "hdrOpt": {
            "type": "integer",
            "description": "HDR option: 1 - HDR, 2 - HDR to HDR Vivid",
            "format": "int32",
            "example": 1
          },
          "hdrMode": {
            "type": "string",
            "description": "HDR transfer format: PQ or HLG",
            "example": "PQ"
          },
          "hdrLuminosity": {
            "type": "integer",
            "description": "HDR peak luminosity (nits). Allowed values: 1000, 850, 750, 550, 260, 203",
            "format": "int32",
            "example": 1000
          },
          "hdrToHdrVividEnable": {
            "type": "boolean",
            "description": "Enable HDR to HDR Vivid conversion for HDR input. Defaults to false",
            "default": false
          }
        },
        "description": "SDR to HDR parameters"
      },
      "SdrToHdrTaskCreateParam": {
        "required": [
          "inputUrl",
          "param"
        ],
        "type": "object",
        "properties": {
          "taskName": {
            "type": "string",
            "description": "Task name, optional",
            "example": "sdr-to-hdr-demo"
          },
          "inputUrl": {
            "type": "string",
            "description": "Source video download URL (http/https)",
